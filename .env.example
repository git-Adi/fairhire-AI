# Named AWS CLI profile (created with: aws configure --profile mugambo). No keys go in this file.
AWS_PROFILE=mugambo
AWS_REGION=us-east-1

# Agents: strong tool-calling model. Bias judge: small, fast model.
# To use Claude instead (needs the Anthropic Marketplace subscription on the account):
#   AGENT_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
#   JUDGE_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
AGENT_MODEL_ID=us.amazon.nova-pro-v1:0
JUDGE_MODEL_ID=us.amazon.nova-lite-v1:0

# spaCy model used by Presidio for name detection
SPACY_MODEL=en_core_web_md
